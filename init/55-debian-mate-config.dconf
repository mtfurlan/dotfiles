[general]
history-mate-run=['pavucontrol', 'chromium', 'librewolf', 'signal-desktop', 'keepassxc', 'syncthing-gtk', 'qalculate', 'strawberry', 'arandr', 'kicad']
object-id-list=['notification-area', 'clock', 'object-2', 'object-0', 'object-1', 'object-3']
toplevel-id-list=['top']

[objects/clock]
applet-iid='ClockAppletFactory::ClockApplet'
locked=true
object-type='applet'
position=10
relative-to-edge='end'
toplevel-id='top'

[objects/clock/prefs]
custom-format='%F | %a %b | %T'
format='custom'
show-seconds=true

[objects/notification-area]
applet-iid='NotificationAreaAppletFactory::NotificationArea'
locked=true
object-type='applet'
position=20
relative-to-edge='end'
toplevel-id='top'

[objects/object-0]
applet-iid='WnckletFactory::WindowListApplet'
locked=true
object-type='applet'
position=20
relative-to-edge='start'
toplevel-id='top'

[objects/object-1]
launcher-location='/usr/share/applications/Alacritty.desktop'
locked=true
object-type='launcher'
position=10
relative-to-edge='start'
toplevel-id='top'

[objects/object-2]
locked=true
object-type='menu'
position=0
tooltip='Compact Menu'
toplevel-id='top'
use-menu-path=false

[objects/object-3]
action-type='shutdown'
locked=true
object-type='action'
position=0
relative-to-edge='end'
toplevel-id='top'

[toplevels/top]
expand=true
orientation='top'
screen=0
size=24
