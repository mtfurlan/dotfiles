#!/bin/bash
set -euo pipefail
#TODO: support linking to dirs
#TODO: support -u or some way to speicy origin

# shellcheck disable=SC2120
h () {
    # if arguments, print them
    [ $# == 0 ] || echo "$*"

  cat <<EOF
Usage: $0 [FILE [LINE NUMBER [LINE NUMBER]]]
       $0
Link to the online git file or repo, with optional line number(s)
  -h, --help       display this help and exit
  -v, --verbose    increase verbosity, may be used more than once
EOF

    # if args, exit 1 else exit 0
    [ $# == 0 ] || exit 1
    exit 0
}

log() {
    level=$1
    shift
    if [[ "$verbosity" -ge "$level" ]]; then
        msg "$*"
    fi
}
msg() {
    echo >&2 -e "${1-}"
}

die() {
    local msg=$1
    local code=${2-1} # default exit status 1
    msg "$msg"
    exit "$code"
}

# get the default branch for remote
gitRemoteDefaultBranch() {
    # pass in remote or default to first
    remote=${1:-$(_git remote | head -n1)}

    # if this fails cause dangling head, do
    # git remote set-head origin -a
    # it can fail for other reasons and we probably don't care in this case
    ret=0
    output=$(_git rev-parse --abbrev-ref "$remote/HEAD" 2>/dev/null | sed "s/$remote\///" || _git remote set-head "$remote" -a 2>/dev/null | sed 's/.*set to //') || ret=$?
    if [[ "$ret" -ne 0 ]]; then
        return
    else
        echo "$output"
    fi
}

gitDirForFile()
{
    local f=$1
    local dir

    if [[ -d "$f" ]]; then
        dir="$f"
    elif [[ -e "$f" ]]; then
        dir=$(dirname "$f")
    else
        die "no such file/dir '$f'?"
    fi
    git -C "$dir" rev-parse --show-toplevel
}

gitArgs=()
_git()
{
    git "${gitArgs[@]}" "$@"
}

findRemoteInfo()
{
    local -n remoteArg=$1 branchArg=$2 shaArg=$3
    branchArg=$(_git rev-parse --abbrev-ref HEAD)
    # shellcheck disable=SC2034 # unused because nameref
    shaArg=$(_git rev-parse --verify HEAD)
    if [[ "$branchArg" == "HEAD" ]]; then
        branchArg=""
        remoteArg=$(git remote | head -n1)
        if [[ "$(git remote | wc -l)" -gt 1 ]]; then
            msg "warning, not on a branchArg, so picking remote '$remoteArg' because it's first"
        fi
        return
    fi

    # find upstream and upstream branch
    local upstreamBranch
    upstreamBranch=$(_git for-each-ref --format='%(upstream:short)' "$(_git symbolic-ref -q HEAD)")
    if [[ -z "$upstreamBranch" ]]; then
        die "your branch '$branchArg' has no upstream tracking branch"
    fi

    remoteArg=$(echo "$upstreamBranch" | sed 's/\/.*//')

}

# shellcheck disable=SC2034 # unused because nameref
parseRemoteURL()
{
    local url=$1
    local -n hostArg=$2 ownerArg=$3 repoArg=$4
    local fields
    fields=$(echo "$url" | perl -ne '($host, $owner, $repo) = /^(?:https?:\/\/|git@)([^:\/]*)(?:[:\/])([^\/]*)\/(.*?)(?:.git)?+\/?$/; print "$host\t$owner\t$repo";')
    hostArg=$(echo "$fields" | cut -d$'\t' -f1)
    ownerArg=$(echo "$fields" | cut -d$'\t' -f2)
    repoArg=$(echo "$fields" | cut -d$'\t' -f3)
}

doStuff()
{
    local relFile=$1
    local line=$2
    local line2=$3
    log 1 "file: '$relFile', line: $line, line2: $line2"

    local file=""
    if [ -n "$relFile" ]; then
        local gitRoot fullFile
        # if we have file, get the git dir for it so we talk to that git
        gitRoot=$(gitDirForFile "$relFile")
        gitArgs+=(-C "$gitRoot")
        log 2 "gitArgs: ${gitArgs[*]}"

        # get file relative to git root
        fullFile=$(realpath "$relFile") # get full path of relative filepath
        log 3 "full filepath: $fullFile"
        log 3 "git root: $gitRoot"
        file=${fullFile#"$gitRoot"} # remove prefix of $gitRoot, will do /README.md
        file=$(echo "$file" | sed "s/^\///") # remove ^/
        log 2 "file relative to repo root: $file"
    fi

    local remote branch sha defaultBranch
    findRemoteInfo remote branch sha

    # shellcheck disable=SC2034 # unused because nameref
    defaultBranch=$(gitRemoteDefaultBranch "$remote")
    log 2 "remote: '$remote', branch: '$branch', sha: '$sha', default branch: '$defaultBranch'"

    # get git remote URL
    local url
    if ! url=$(_git config --get "remote.$remote.url"); then
        die "no remote?"
    fi

    local host owner repo
    parseRemoteURL "$url" host owner repo
    log 2 "repo remote url '$url' parsed to '$host' '$owner' '$repo'"

    # handle stuff like git@github.com-company without parsing the ssh config
    local provider repoFileSeparator repoTreeSeparator lineStr
    lineStr=""
    case "$host" in
        *"github.com"*)
            provider=github.com
            repoFileSeparator=blob
            repoTreeSeparator=tree
            if [ -n "$line" ]; then
                lineStr="#L$line"
                if [ -n "$line2" ]; then
                    lineStr+="-L$line2"
                fi
            fi
            ;;
        *"gitlab.com"*)
            provider=gitlab.com
            repoFileSeparator=-/blob
            repoTreeSeparator=-/blob # TODO check
            if [ -n "$line" ]; then
                lineStr="#L$line"
                if [ -n "$line2" ]; then
                    lineStr+="-$line2"
                fi
            fi
            ;;
        #*"bitbucket.org"*)
        #    provider=bitbucket.org
        #    if [ -n "$line" ]; then
        #        lineStr="#lines-$line"
        #    fi
        #    ;;
        *)
            die "don't support $host yet"
            ;;
    esac

    local repoURL="https://$provider/$owner/$repo"

    local target=${branch:-$sha}



    if [ -z "$file" ]; then
        if [[ "$branch" == "$defaultBranch" ]]; then
            echo "$repoURL"
        else
            echo "$repoURL/$repoTreeSeparator/$target"
        fi
        exit 0
    fi

    #echo "file: $file"

    # print the URL
    url="$repoURL/$repoFileSeparator/$target/$file$lineStr"
    echo "$url"
    exit 0
}

# run only if not sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    if ! PARSED_ARGS=$(getopt -o hv --long help,verbose -n "$0" -- "$@") ; then
        h "getopt issue ^"
    fi
    eval set -- "$PARSED_ARGS"

    verbosity=0
    while true ; do
        case "$1" in
            -h|--help) h; ;;
            -v|--verbose) verbosity=$((verbosity+1)) ; shift ;;
            --) shift ; break ;;
            *) die "issue parsing args, unexpected argument '$0'!" ;;
        esac
    done


    relFile=${1:-}
    line=${2:-}
    line2=${3:-}
    doStuff "$relFile" "$line" "$line2"
fi
